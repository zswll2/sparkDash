PORT=5555
# Listen address. Remote binds require an account (npm run auth:init <user>) or
# SPARKDASH_TOKEN — otherwise startup fails closed. See docs/REMOTE-ACCESS.md.
BIND_HOST=127.0.0.1
LLM_PORT=8888
# ─── Dashboard account ───────────────────────────────────────────────────
# Preferred: the scrypt hash printed by `npm run auth:hash` — nothing reversible
# is stored. Use the same value wherever the same login should work.
# SPARKDASH_ADMIN_USER=admin
# SPARKDASH_ADMIN_PASSWORD_HASH=scrypt:16384:8:1:<salt-hex>:<hash-hex>
# Convenience: a plaintext password seeds config/auth.json on first start; delete
# this line afterwards. An existing config/auth.json always wins over both.
# SPARKDASH_ADMIN_PASSWORD=
# Optional Bearer token for scripts/automation; works alongside session login.
# SPARKDASH_TOKEN=
# HTTPS switch. Default on: serve https:// with config/tls/server.crt|key
# (generate with npm run tls:gen). Off is only allowed on a loopback bind.
TLS_ENABLED=1
# Optional overrides for the TLS certificate/key paths.
TLS_CERT_PATH=
TLS_KEY_PATH=
# Sliding session lifetime for the login cookie (ms; default 12h).
SESSION_TTL_MS=43200000
# Login lockout: lock the source IP after this many consecutive failures…
LOGIN_MAX_FAILS=5
# …for this many ms (default 15 minutes). Correct passwords get 429 while locked.
LOGIN_LOCK_MS=900000
POLL_INTERVAL_GPU=2000
POLL_INTERVAL_CPU=2000
POLL_INTERVAL_NETWORK=2000
POLL_INTERVAL_STORAGE=5000
POLL_INTERVAL_LLM=2000
POLL_INTERVAL_BANDWIDTH=1000
# Optional: ssh -i path inside the container when the key is not a default OpenSSH name.
# The mounted private key must be mode 600 on the host.
# SSH_IDENTITY_FILE=/root/.ssh/id_ed25519
# Reuse authenticated SSH transports for remote polling. Set to 0 to disable.
SSH_CONTROL_PERSIST_SECONDS=60
